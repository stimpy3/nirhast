# Optional. The app runs without any keys (browser speech in, browser voice out, word rules).
# Copy this file to .env and fill in only the keys you have. Never put real keys in THIS file:
# .env.example is public on GitHub, .env is not.

# Speech in: Wispr Flow (used first if set)
WISPR_API_KEY=

# Groq: sorts messages into types (LLM) and, if no Wispr key, turns speech into text (Whisper)
GROQ_API_KEY=
# GROQ_COOK_MODEL=openai/gpt-oss-20b
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3

# Sarvam: the app's voice in English, Hindi and Marathi
SARVAM_API_KEY=
# SARVAM_MODEL=bulbul:v3
# SARVAM_SPEAKER=priya
# Translate messages to English before the AI sorts them (Sarvam). Set to false to switch off.
# TRANSLATE_BEFORE_SORT=true
